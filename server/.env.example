# Kawalys BFF real mode (BACK-56). Copy to .env.local (gitignored) and fill in; never commit values.
# Leave ALL of these unset for synthetic routes only. Set one and every one is required.
# Nothing here is provisioned yet: Neon, Descope and hosting are separate approvals (gates B and D).

# Runtime login (role kawalys_app): workspace data under forced RLS. Direct or pooled endpoint.
KAWALYS_DATABASE_URL_APP=
# Sign-in login (role kawalys_auth): identity and session tables only. Must differ from the app role.
KAWALYS_DATABASE_URL_AUTH=
# The separate Kawalys Descope project id (public value; no Descope secret is needed to verify tokens).
KAWALYS_DESCOPE_PROJECT_ID=
# The first sign-in with this provider-verified email becomes the single owner (Personal Alpha).
KAWALYS_OWNER_EMAIL=
# Optional, recommended before the first real sign-in: only this Descope subject may become the owner.
# Without it, the first token carrying the verified owner email wins permanently.
# KAWALYS_OWNER_SUBJECT=
# The one browser origin allowed to sign in and out: https, or http only for localhost. No path.
KAWALYS_ALLOWED_ORIGIN=

# Optional
KAWALYS_BFF_PORT=8787
