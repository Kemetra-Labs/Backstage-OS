# Kawalys BFF configuration. Copy to .env.local (gitignored) and fill in; never commit values.
# Nothing here is provisioned yet: Neon, Descope and hosting are separate approvals (gates B and D).
# With none of these set the server denies every protected route and uses no database.

# Database (BACK-55). Set BOTH or NEITHER, and the two logins must use different roles.
# Runtime login (role kawalys_app): workspace data under forced RLS.
KAWALYS_DATABASE_URL_APP=
# Sign-in login (role kawalys_auth): identity and session tables only.
KAWALYS_DATABASE_URL_AUTH=

# Authentication (PR #76).
# The separate Kawalys Descope project id (public value; no Descope secret is needed to verify tokens).
KAWALYS_DESCOPE_PROJECT_ID=
# Optional https issuer override (for example a custom domain); default is derived from the project id.
# KAWALYS_DESCOPE_ISSUER=
# The one owner's Descope user id (the token subject). Required with the project id in production.
KAWALYS_OWNER_SUBJECT=
# Optional, 60-3600 seconds, default 900: how old a Descope token may be when exchanged for a session.
# KAWALYS_DESCOPE_MAX_TOKEN_AGE_SECONDS=
# Optional, 300-86400 seconds, default 28800: absolute session lifetime.
# KAWALYS_SESSION_ABSOLUTE_TTL_SECONDS=
# Optional, 60 up to the absolute lifetime, default 3600: idle session timeout.
# KAWALYS_SESSION_IDLE_TTL_SECONDS=

# Optional, integer 1-100, default 10: sign-in attempts per 60 s window on POST /auth/session. Past it the route
# answers 429 without checking the token. Behind loopback every caller shares one address, so it is effectively global.
# KAWALYS_AUTH_SIGN_IN_LIMIT_PER_MINUTE=
# Owner lab (K-ID-1b): the value 1 serves the loopback sign-in page GET /auth/lab and logs why a token was refused.
# GET /auth/lab also needs KAWALYS_DESCOPE_PROJECT_ID (otherwise it is a 404).
# Any other non-empty value, or 1 with NODE_ENV=production, refuses to boot. Leave unset except for a lab run on
# your own machine (docs/planning/BACK-56/K-ID-1b-lab-runbook.md).
# KAWALYS_AUTH_LAB=

# Optional, default 8787: the port (the server binds 127.0.0.1 only).
# KAWALYS_BFF_PORT=
