{
  "name": "kawalys-bff",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "description": "Kawalys BFF: synthetic routes plus a locally tested PostgreSQL foundation (BACK-55 S1); no provisioned DB, auth, connectors or secrets",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "check": "npm run typecheck && npm test",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.6.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
