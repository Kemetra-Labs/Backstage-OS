      "change": { "addEvents": [
        { "slot": "life:T2", "value": "complete", "options": { "revision": "r2", "order": 2, "ref": "life:T2-r2", "effectiveAt": "10:01", "recordedAt": "10:02" } },
        { "slot": "life:T2", "value": "pending", "options": { "recordedAt": "10:04" } }
