{
  "name": "kawalys-s1-investigation-room",
  "private": true,
  "version": "0.1.0",
  "description": "Kawalys S1: Investigation Room mock slice, synthetic data only (BACK-6)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "tsc --noEmit && vitest run --coverage",
    "e2e": "vite build && playwright test -c playwright.config.ts",
    "dev:v2": "vite --config vite.v2.config.ts --open /v2.html",
    "build:v2": "tsc --noEmit && vite build --config vite.v2.config.ts",
    "e2e:v2": "vite build --config vite.v2.config.ts && playwright test -c playwright.v2.config.ts"
  },
  "dependencies": {
    "@xyflow/react": "13.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
