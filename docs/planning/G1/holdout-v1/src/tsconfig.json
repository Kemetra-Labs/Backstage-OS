{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "experimentalDecorators": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@ledger": ["packages/ledger/src/index.ts"],
      "@ledger/*": ["packages/ledger/src/*"],
      "~atlas/*": ["packages/atlas/src/*"]
    }
  },
  "include": ["packages/**/*"]
}
