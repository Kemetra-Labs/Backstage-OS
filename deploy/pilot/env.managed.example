# Names only. Copy to .env.pilot (gitignored), fill in, and pass it with --env-file. Never commit values.
# Managed PostgreSQL profile (compose.managed.yml, BACK-115). Passwords inside URLs must be URL-encoded.

# Host name Caddy serves and obtains a certificate for ("localhost" uses Caddy's internal CA: local only).
# Must be a lower-case bare host name (no scheme, no port, no path): the origin allowlist derives https://<site> from it, and a non-canonical value stops the BFF at boot.
KAWALYS_SITE_ADDRESS=
# Origins allowed to make state-changing requests (comma-separated, exact scheme://host[:port], no wildcard).
# Leave empty to use https://<KAWALYS_SITE_ADDRESS>. Set it only when the public https port is not 443.
KAWALYS_ALLOWED_ORIGINS=
# Host names the BFF answers to (BACK-172; required, the BFF refuses to start in production without it). Comma-separated host
# names, each with an optional :port (an entry without a port allows any port); no scheme, path or wildcard. Use
# <KAWALYS_SITE_ADDRESS>,localhost,127.0.0.1: Caddy forwards the original Host to the BFF (the site host), and the container
# healthcheck calls 127.0.0.1. Any other Host header gets 404. preflight-deploy.sh requires 127.0.0.1 to be listed.
KAWALYS_ALLOWED_HOSTS=
# Deploy images (compose.deploy.yml, BACK-117): built in CI, referenced by digest only. Each must be
# ghcr.io/kemetra-labs/...@sha256:<64 hex> (the lines the images workflow writes to its run summary).
# KAWALYS_BFF_IMAGE=
# KAWALYS_WEB_IMAGE=

# Real client address behind Cloudflare (BACK-117). Leave empty until the site is proxied through Cloudflare.
# Then set space-separated Cloudflare IPv4 and IPv6 ranges from https://www.cloudflare.com/ips/ (fetched at setup, never hard-coded
# in the repo); Caddy then trusts CF-Connecting-IP only from those peers. Empty means loopback only (trust nobody).
KAWALYS_TRUSTED_PROXIES=

# Cloudflare Origin CA certificate (compose.origin-cert.yml, BACK-117). Used only when that file is part of the compose command;
# without it Caddy keeps its automatic certificate. A host directory (outside the git checkout) holding origin.pem and origin.key,
# both owned by uid 10001, key mode 0400. Never commit them. See runbook section 11, "Origin certificate".
# KAWALYS_ORIGIN_CERT_DIR=/opt/kawalys/tls

# Host ports for web (default 80 and 443; leave empty to use the defaults).
KAWALYS_HTTP_PORT=
KAWALYS_HTTPS_PORT=

# Private Compose network range (default 172.30.42.0/24). Change only if it collides with a network on the host.
KAWALYS_NETWORK_SUBNET=

# Whole database URLs, all with sslmode=verify-full (the BFF refuses a non-loopback host without it).
# Runtime URLs (app and auth roles) may use the provider's pooled host.
KAWALYS_DATABASE_URL_APP=
KAWALYS_DATABASE_URL_AUTH=
# The next four lines are needed only while running the ops commands (provision, migrate). Remove them from .env.pilot afterwards:
# the running bff and web must not have the owner-level credential in their env file.
# Admin URL must be the provider's direct host, never a -pooler host.
KAWALYS_ADMIN_DATABASE_URL=
# Passwords the provision step sets for the migrator, app and auth roles. The three must differ and match the runtime URLs.
KAWALYS_ROLE_PASSWORD_MIGRATOR=
KAWALYS_ROLE_PASSWORD_APP=
KAWALYS_ROLE_PASSWORD_AUTH=

# Owner-only auth. Leave both empty and the BFF stays deny-all (no signed-in routes).
KAWALYS_DESCOPE_PROJECT_ID=
KAWALYS_OWNER_SUBJECT=
# Optional auth tuning; empty means the BFF default.
KAWALYS_DESCOPE_ISSUER=
KAWALYS_DESCOPE_MAX_TOKEN_AGE_SECONDS=
KAWALYS_SESSION_ABSOLUTE_TTL_SECONDS=
KAWALYS_SESSION_IDLE_TTL_SECONDS=
KAWALYS_AUTH_SIGN_IN_LIMIT_PER_MINUTE=

# Local only. Leave empty for the pilot: production refuses to start without auth.
KAWALYS_NODE_ENV=
